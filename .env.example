# ================================================================
# ELMS - External License Management System
# Copy this file to ".env" and adjust values for your environment.
# ================================================================

# Application
APP_NAME="External License Manager"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Base path for the API (used by SDKs / WHMCS module)
API_BASE_PATH=/api

# Database (default XAMPP MariaDB credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elms
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Security
# Global application secret used for internal signing/hashing salts.
APP_KEY=change-this-to-a-long-random-string

# Session
SESSION_NAME=elms_session
SESSION_LIFETIME=7200

# API request signature: allowed clock skew in seconds for X-Timestamp
SIGNATURE_MAX_SKEW=300

# Rate limiting (per API key + per IP), sliding window
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# Logging
LOG_PATH=storage/logs
